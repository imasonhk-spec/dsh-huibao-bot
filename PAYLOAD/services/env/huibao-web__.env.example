# PRIVATE: user-provided gateway credentials. Do not commit or redistribute this file.
# The corporate DNS resolves this exact HTTPS gateway to 172.16.120.252.
# Trust only this origin; paths below remain separately configured.
DESKBOT_PROVIDER_PRIVATE_ORIGINS=https://modelhub.lgdg.cc,http://127.0.0.1:18661,http://127.0.0.1:18662,http://127.0.0.1:18100,http://127.0.0.1:18664
ASR_PROVIDER=openai_compatible
ASR_ENDPOINT=http://127.0.0.1:18661/v1/audio/transcriptions
ASR_MODEL=inclusionAI/Ming-3.0-asr-tiny
ASR_API_KEY=__GEN__
ASR_RESPONSE_FORMAT=json
ASR_STREAM=false
ASR_TIMEOUT_SECONDS=120.0
ASR_LANGUAGE=auto
TTS_PROVIDER=openai_compatible
TTS_ENDPOINT=http://127.0.0.1:18662/v1/audio/speech
TTS_MODEL=inclusionAI/Ming-3.0-tts-0.5B
TTS_VOICE=灵小柔
TTS_API_KEY=__GEN__
TTS_TIMEOUT_SECONDS=600.0

# 各提供方的大模型 Key（切换提供方时自动带出，由控制台维护）
LLM_API_KEY_HOST_TOKENS_STORE=__GEN__

# 大模型 LLM
LLM_BASE_URL=http://127.0.0.1:18100/v1
LLM_API_KEY=__GEN__

# 大模型 LLM
LLM_MODEL=huiwen-2-agron:latest

# 火山语音本机凭证
VOLCENGINE_ASR_API_KEY=__GEN__

# 语音识别 ASR
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.auc

# 配置
CAMERA_PREVIEW_DISABLED_DEVICES=deskbot_1cdbd46017ac

# --- 控制台远程访问（huibao 2026-10-21）：WiFi / 局域网 / Tailscale 直连 ---
DESKBOT_WEB_HOST=0.0.0.0
DESKBOT_WEB_PORT=5050
DESKBOT_WEB_ALLOW_REMOTE=1
# 额外允许的主机名（逗号分隔）；留空则自动放行私有网段/CGNAT 的 IP 字面量
DESKBOT_WEB_ALLOWED_HOSTS=dsh.ilica.cn,dsh2.ilica.cn

# 各提供方的大模型 Key（切换提供方时自动带出，由控制台维护）
LLM_API_KEY_HOST_127_0_0_1=__GEN__
